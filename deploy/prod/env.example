# /etc/bluebird/ 아래에 호스트별로 필요한 파일만 둔다. 권한 0600 root:root. 저장소에는 예시만.
# 값에는 따옴표를 쓰지 않는다(systemd와 podman --env-file이 따옴표를 다르게 읽는다).
# 코드가 읽는 이름만 적었다: pipeline/bluebird/{cli,api,egress,llm,funnel,announce,sources_check}.py,
#   web/portal/lib/db.ts, web/console/lib/api.ts, deploy/test/compose.yaml.

# ================= 업무망 호스트 =================

# ---- bluebird.env (공통)
BB_VERSION=0.1.0

# ---- 작업별 env: ingest.env / signals.env / publish.env / pull-objections.env
#      BB_JOB_ARGS = bluebird-job@.service 가 이미지에 넘기는 명령
# ingest.env
#   BB_JOB_ARGS=ingest
# signals.env
#   BB_JOB_ARGS=signals catalog-fetch --out-dir /srv/bluebird/signals
# publish.env
#   BB_JOB_ARGS=publish
# pull-objections.env
#   BB_JOB_ARGS=objections pull

# ---- 작업 공통(위 작업 env에 필요한 것만 넣는다)
# core DB (업무망 내부 DB)
BB_DSN=postgresql://bluebird:<password>@10.20.10.21:5432/bluebird_core?sslmode=verify-full
# 수집 설정·익명화 비밀·시드·신호 저장 폴더
BB_SOURCES=/config/sources.toml
BB_SEED_DIR=/srv/bluebird/seed
BB_SIGNAL_DIR=/srv/bluebird/signals
BB_ANON_SECRET=/keys/anon_secret
# 외부 조회는 DMZ 포워드 프록시로만 나간다(pipeline/bluebird/egress.py)
BLUEBIRD_EGRESS_PROXY=http://172.16.30.31:3128

# ---- publish.env 전용: DMZ 공개용 DB로 밀어넣기(역할 bb_publisher)
BB_PUBLISH_DSN=postgresql://bb_publisher:<password>@172.16.30.21:5432/bluebird_publish?sslmode=verify-full
# 스키마 마이그레이션(`bluebird migrate --target publish`)을 돌릴 때만 사용(역할 bb_migrator)
# BB_PUBLISH_MIGRATOR_DSN=postgresql://bb_migrator:<password>@172.16.30.21:5432/bluebird_publish?sslmode=verify-full

# ---- pull-objections.env 전용: 이의 제기 가져오기·삭제(역할 bb_inbox_reader)
BB_INBOX_DSN=postgresql://bb_inbox_reader:<password>@172.16.30.21:5432/bluebird_publish?sslmode=verify-full

# ---- 외부 키. 아직 없는 키(key_required)는 비워 둔다. 비면 해당 소스는 건너뛰고 사람 경로로 간다.
DATA_GO_KR_KEY=
LAW_OC=
BIZINFO_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KIPRIS_PLUS_KEY=
# 상용 LLM(N2SF 허용 자료만, egress 경유). 둘 다 비면 규칙·사람 경로로만 동작
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# BB_LLM_PROVIDER=openai
# BB_LLM_MODEL=

# ---- api.env (bluebird-api.service)
# 최소 권한 역할 bb_api(core DB). 토큰 해시 파일은 -v 로 /secrets 에 마운트
# BB_DSN=postgresql://bb_api:<password>@10.20.10.21:5432/bluebird_core?sslmode=verify-full
# BB_API_USERS=/secrets/console_users.json
# BB_API_HOST=127.0.0.1
# BB_API_PORT=8000

# ---- console.env (bluebird-console.service)
# BB_API_URL=http://127.0.0.1:8000
# PORT=3001
# HOSTNAME=127.0.0.1

# ================= DMZ 호스트 =================

# ---- bluebird.env (공통)
# BB_VERSION=0.1.0

# ---- portal.env (bluebird-portal.service). 공개용 DB는 bb_portal로만 접속
# PORTAL_DATABASE_URL=postgresql://bb_portal:<password>@172.16.30.21:5432/bluebird_publish?sslmode=verify-full
# PORTAL_DB_POOL_MAX=10
