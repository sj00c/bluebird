# 업무망 호스트. 관리자 콘솔(Next.js). 루프백 3001에서만 수신, 앞단은 console-gw(nginx).
# 콘솔은 backend-api(루프백 8000)만 부른다.
[Unit]
Description=bluebird console (업무망)
Wants=bluebird-api.service
After=bluebird-api.service

[Service]
EnvironmentFile=/etc/bluebird/bluebird.env
ExecStart=/usr/bin/podman run --rm --name bb-console --network=host \
  --user 10001:10001 --read-only --tmpfs /tmp \
  --env-file /etc/bluebird/console.env \
  -e HOSTNAME=127.0.0.1 -e PORT=3001 -e BB_API_URL=http://127.0.0.1:8000 \
  bluebird/console:${BB_VERSION}
ExecStop=/usr/bin/podman stop -t 10 bb-console
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
