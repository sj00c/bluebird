# 업무망 호스트. 관리자 콘솔용 API(FastAPI). 루프백 8000에서만 수신하고 외부 연결이 없다.
# core DB에는 최소 권한 역할 bb_api로만 접속한다. 토큰 해시는 BB_API_USERS(console_users.json).
[Unit]
Description=bluebird backend-api (업무망)
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/bluebird/bluebird.env
ExecStart=/usr/bin/podman run --rm --name bb-api --network=host \
  --user 10001:10001 --read-only --tmpfs /tmp \
  --env-file /etc/bluebird/api.env \
  -e BB_API_HOST=127.0.0.1 -e BB_API_PORT=8000 \
  -v /etc/bluebird/console_users.json:/secrets/console_users.json:ro,Z \
  --entrypoint python \
  bluebird/pipeline:${BB_VERSION} -m bluebird.api
ExecStop=/usr/bin/podman stop -t 10 bb-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
