# 파랑새 로컬 데모 설정. `cp .env.example .env` 또는 ./demo.sh init(빈 값만 채움).
# .env = git 제외.

# ── 로컬 DB (init 자동 생성) ─────────────────────────────
DB_PASSWORD=

# ── 포트 (127.0.0.1 전용) ─────────────────────────────
BB_PORTAL_PORT=3000
BB_CONSOLE_PORT=3001
BB_API_PORT=8000
BB_DB_PORT=54329

# ── 외부 API 키 (빈 값 → 해당 소스 key_required) ──
# LLM: 카드 요약(P1)·원인 제안(P2)·시의성 제안(P3). 공급자 = 키 있는 쪽(둘 다 → openai, BB_LLM_PROVIDER로 고정).
# 반출 = O급 허용 필드만. 모델 기본값: openai gpt-4.1-mini / anthropic claude-sonnet-4-5
BB_LLM_PROVIDER=
BB_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 네이버 검색(뉴스): 사업화 흔적 - 후속 보도. NAVER API HUB(NCP) Client ID/Secret  https://console.ncloud.com (개발자센터 검색 API 신규 발급 2026-07-31 종료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# KIPRIS Plus: 공모전 아이디어DB 수집 + 사업화 흔적 후보 - 특허·실용신안  https://plus.kipris.or.kr
KIPRIS_PLUS_KEY=
# 공공데이터포털(키 1개 공용, 서비스별 활용신청): K-Startup 공고 15125364, 권익위 공모제안 15059115, 권익위 공개제안 15059423(수집)  https://www.data.go.kr
DATA_GO_KR_KEY=
# 서울 열린데이터광장 일반 인증키: 시민참여예산 접수·선정 수집  https://data.seoul.go.kr
SEOUL_OPENAPI_KEY=
# 경기데이터드림 OpenAPI 인증키: 주민참여예산 제안사업 수집  https://data.gg.go.kr
GG_OPENAPI_KEY=
# 권익위 공개제안 1회 수집 호출 상한(개발계정 일 10,000). 비우면 9000
BB_ACRC_CALL_BUDGET=
# 기업마당 공고  https://www.bizinfo.go.kr/apiList.do
BIZINFO_KEY=
# 국가법령정보 OC(빈 값 → 시험 계정 test)  https://open.law.go.kr
LAW_OC=

