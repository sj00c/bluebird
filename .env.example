# 파랑새 로컬 데모 설정. `cp .env.example .env` 하거나 ./demo.sh init 이 없는 값만 채운다.
# .env 는 git에 올리지 않는다.

# ── 로컬 DB (init이 자동 생성) ─────────────────────────────
DB_PASSWORD=

# ── 포트 (127.0.0.1에만 열린다) ─────────────────────────────
BB_PORTAL_PORT=3000
BB_CONSOLE_PORT=3001
BB_API_PORT=8000
BB_DB_PORT=54329

# ── 외부 API 키 (비워 두면 해당 소스는 key_required로 표시) ──
# LLM: 원인 진단·카드 요약(P1·P2·P3). 키가 있는 쪽을 쓴다(둘 다 있으면 openai, BB_LLM_PROVIDER로 고정 가능).
# 공개 허용 소스 필드만 나간다. 모델 기본값: openai gpt-4.1-mini / anthropic claude-sonnet-4-5
BB_LLM_PROVIDER=
BB_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 네이버 검색(뉴스): 사업화 흔적 - 후속 보도  https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# KIPRIS Plus: 사업화 흔적 - 특허·상표  https://plus.kipris.or.kr
KIPRIS_PLUS_KEY=
# 공공데이터포털: K-Startup 공고(15125364), 권익위 국민제안(15059115)  https://www.data.go.kr
DATA_GO_KR_KEY=
# 기업마당 공고  https://www.bizinfo.go.kr/apiList.do
BIZINFO_KEY=
# 국가법령정보 OC(비우면 시험 계정 test)  https://open.law.go.kr
LAW_OC=
